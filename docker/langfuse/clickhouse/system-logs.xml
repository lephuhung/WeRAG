<!--
  Keeps ClickHouse's own bookkeeping from outgrowing the Langfuse data it serves.
  Left alone, the server logs every query, metric sample and stack trace into
  system.* tables and a trace-level text log; on a quiet dev box that was
  ~1 GB in ten days against ~3 MB of traces.

  Tables removed here are no longer written, but the ones already on disk stay
  until dropped once by hand (see docs/Langfuse集成.md).
-->
<clickhouse>
    <logger>
        <level>warning</level>
        <size>100M</size>
        <count>3</count>
    </logger>

    <!-- Kept for troubleshooting, a week at most. -->
    <query_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </query_log>
    <part_log>
        <ttl>event_date + INTERVAL 7 DAY DELETE</ttl>
    </part_log>

    <text_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <latency_log remove="1"/>
    <processors_profile_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <session_log remove="1"/>
    <opentelemetry_span_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
    <backup_log remove="1"/>
    <s3queue_log remove="1"/>
    <blob_storage_log remove="1"/>
</clickhouse>
