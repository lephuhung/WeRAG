# Copy to .env.development.local (next dev) or .env.production.local
# (next build / next start); *.local files are git-ignored.

# Go backend that /api/* and /files/* are rewritten to.
# Dev default: http://127.0.0.1:8080 (the backend's default APP_PORT).
# Required for `next build` / `next start` — the build fails without it.
# WERAG_BACKEND_URL=http://127.0.0.1:8080

# Comma-separated hosts allowed to load dev assets when the dev server is
# opened from another machine (next dev allowedDevOrigins).
# Default: 127.0.0.1,localhost
# WERAG_DEV_ORIGINS=127.0.0.1,localhost

# sherpa-onnx speech service that /asr/* is rewritten to (browser dictation).
# Default: http://127.0.0.1:8110
# WERAG_ASR_URL=http://127.0.0.1:8110

# Public HTTPS origin serving the Word add-in at /word/. Recommended in
# production, especially behind a reverse proxy. No path or trailing query.
# The manifest download uses this origin for all add-in URLs.
# Local development defaults to https://localhost:3000 (Office dev server).
# WERAG_WORD_ADDIN_ORIGIN=https://werag.example.gov.vn
