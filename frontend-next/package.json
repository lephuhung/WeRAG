{
  "name": "werag-frontend-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:formula-number": "tsc --rewriteRelativeImportExtensions --esModuleInterop --skipLibCheck --target es2022 --module commonjs --types node --outDir node_modules/.cache/formula-number-test lib/formula-number.ts lib/formula-number.test.ts && node --test node_modules/.cache/formula-number-test/formula-number.test.js",
    "test:legal-paths": "node --experimental-strip-types --test lib/legal-paths.test.ts",
    "test:doc-layout": "node --experimental-strip-types --test components/doc-workspace/document-layout-policy.test.ts",
    "test:large-view": "node --experimental-strip-types --test lib/large-view-policy.test.ts"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "docx": "9.11.0",
    "dompurify": "^3.4.15",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "mermaid": "^11.17.2",
    "next": "^16.4.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/d3-force": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.3"
  }
}
