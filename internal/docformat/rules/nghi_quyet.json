{
  "type": "nghi_quyet",
  "label": "Nghị quyết (NĐ30/2020, Phụ lục I)",
  "required_components": [
    "quoc_hieu",
    "tieu_ngu",
    "co_quan_ban_hanh",
    "trich_yeu",
    "noi_dung",
    "signature",
    "noi_nhan"
  ],
  "optional_components": [
    "co_quan_chu_quan",
    "so_ky_hieu",
    "dia_danh_ngay_thang",
    "can_cu",
    "phu_luc"
  ],
  "checks": [
    {
      "id": "trich_yeu.type_line",
      "kind": "prop",
      "component": "trich_yeu",
      "prop": "text",
      "op": "regex",
      "value": "NGHỊ QUYẾT|NGHI QUYET",
      "mode": "any",
      "desc": "Tên loại văn bản 'NGHỊ QUYẾT' đứng trên trích yếu",
      "severity": "warn"
    },
    {
      "id": "noi_dung.dieu.bold",
      "kind": "regex_prop",
      "component": "noi_dung",
      "regex": "^DIEU\\s+\\d+\\.",
      "prop": "bold",
      "op": "eq",
      "value": true,
      "mode": "all",
      "desc": "Từ 'Điều', số thứ tự và tiêu đề điều in đậm",
      "severity": "warn"
    }
  ],
  "anchors": [
    {
      "id": "resolution_line",
      "regex": "^QUYET (DINH|NGHI)\\s*[:.]?$",
      "max": 1,
      "desc": "dòng QUYẾT ĐỊNH:/QUYẾT NGHỊ:"
    },
    {
      "id": "dieu",
      "regex": "^DIEU\\s+\\d+\\.?",
      "max": 20,
      "desc": "Điều"
    }
  ]
}
