{
  "type": "quyet_dinh",
  "label": "Quyết định (NĐ30/2020, Phụ lục I)",
  "required_components": [
    "quoc_hieu",
    "tieu_ngu",
    "co_quan_ban_hanh",
    "so_ky_hieu",
    "dia_danh_ngay_thang",
    "trich_yeu",
    "can_cu",
    "noi_dung",
    "signature",
    "noi_nhan"
  ],
  "optional_components": [
    "co_quan_chu_quan",
    "do_mat",
    "do_khan",
    "phu_luc"
  ],
  "checks": [
    {
      "id": "trich_yeu.type_line",
      "kind": "prop",
      "component": "trich_yeu",
      "prop": "text",
      "op": "regex",
      "value": "QUYẾT ĐỊNH|QUYET DINH",
      "mode": "any",
      "desc": "Tên loại văn bản 'QUYẾT ĐỊNH' đứng trên trích yếu",
      "severity": "warn"
    },
    {
      "id": "noi_dung.dieu.bold",
      "kind": "regex_prop",
      "component": "noi_dung",
      "regex": "^DIEU\\s+\\d+\\.",
      "prop": "bold",
      "op": "eq",
      "value": true,
      "mode": "all",
      "desc": "Từ 'Điều', số thứ tự và tiêu đề điều in đậm",
      "severity": "warn"
    }
  ],
  "anchors": [
    {
      "id": "resolution_line",
      "regex": "^QUYET (DINH|NGHI)\\s*[:.]?$",
      "max": 1,
      "desc": "dòng QUYẾT ĐỊNH:/QUYẾT NGHỊ:"
    },
    {
      "id": "dieu",
      "regex": "^DIEU\\s+\\d+\\.?",
      "max": 20,
      "desc": "Điều"
    }
  ],
  "judgment": [
    {
      "id": "yeu_cau_rieng",
      "requirements": [
        {
          "check": "anchor_present",
          "anchor": "resolution_line",
          "regex": "^QUYET DINH",
          "desc": "Dòng \"QUYẾT ĐỊNH:\" trước Điều 1",
          "severity": "error",
          "when_absent": "error",
          "fix": "Thêm dòng \"QUYẾT ĐỊNH:\" (in đậm, căn giữa) trước Điều 1."
        },
        {
          "check": "anchor_regex",
          "anchor": "dieu",
          "last": 2,
          "also": [
            "tail"
          ],
          "regex": "HIEU LUC|THI HANH",
          "desc": "Điều cuối nêu hiệu lực và trách nhiệm thi hành",
          "severity": "error",
          "when_absent": "unknown",
          "fix": "Bổ sung Điều cuối: \"Quyết định này có hiệu lực kể từ ngày ký. … chịu trách nhiệm thi hành Quyết định này.\""
        },
        {
          "check": "component_present",
          "component": "tham_quyen_ban_hanh",
          "desc": "Thẩm quyền ban hành (chức vụ người đứng đầu hoặc tên cơ quan) dưới trích yếu",
          "severity": "error",
          "fix": "Thêm dòng thẩm quyền ban hành, ví dụ \"GIÁM ĐỐC SỞ …\"."
        }
      ]
    }
  ]
}
